{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行 minishell",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/minishell",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake 构建",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
